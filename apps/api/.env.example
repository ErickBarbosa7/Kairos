NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kairos:kairos_dev@localhost:5433/kairos?schema=public

# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Orígenes permitidos (lista separada por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Nº de proxies delante de la API (Render/Railway: 1). 0 en local
TRUST_PROXY=0

# URL pública de la API (se usa para armar las URL de imágenes subidas)
PUBLIC_API_URL=http://localhost:3000
# Carpeta local de imágenes. En producción usar almacenamiento externo (S3/Cloudinary)
UPLOADS_DIR=uploads
